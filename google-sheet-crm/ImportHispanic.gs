/**
 * One-time: adds the 57 Hispanic leads (List 3) to the Leads tab,
 * with Plan, Preview Link, Language = Spanish and the pitch in Notes.
 * Safe to run twice — it skips leads that are already there (same name + phone).
 * HOW: Extensions → Apps Script → + → Script → name it "Hispanic" → paste → Save → pick importHispanicLeads → Run.
 */
function importHispanicLeads() {
  const ss = SpreadsheetApp.getActive();
  const sh = ss.getSheetByName(TAB.leads);
  const res = importLeads_(sh, HISPANIC_LEADS);
  const last = lastDataRow_(sh);
  const n = last - 1;
  const names = sh.getRange(2, C["Business Name"], n, 1).getValues().map((r) => String(r[0]).trim().toLowerCase());
  const plan = sh.getRange(2, C["Plan"], n, 1).getValues();
  const prev = sh.getRange(2, C["Preview Link"], n, 1).getValues();
  const lang = sh.getRange(2, C["Language"], n, 1).getValues();
  HISPANIC_LEADS.forEach((l) => {
    const i = names.lastIndexOf(l.businessName.trim().toLowerCase());
    if (i === -1) return;
    if (!plan[i][0]) plan[i][0] = l.plan;
    if (!prev[i][0]) prev[i][0] = l.preview;
    if (!lang[i][0]) lang[i][0] = "Spanish";
  });
  sh.getRange(2, C["Plan"], n, 1).setValues(plan);
  sh.getRange(2, C["Preview Link"], n, 1).setValues(prev);
  sh.getRange(2, C["Language"], n, 1).setValues(lang);
  sh.getRange(2, C["Reviews"], n, 1).setNumberFormat("0");
  ss.toast("Added " + res.added + " Hispanic leads (" + res.skipped + " already there).", "Import", 10);
}

